{
  "passbolt_status": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "description": "Probe Passbolt auth and a v5 decrypt canary. Returns booleans plus registered sink_refs (kind/approval) and allowed domain_hosts; never secrets."
  },
  "passbolt_search": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "default": "",
          "type": "string"
        },
        "target_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limit": {
          "default": 20,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "description": "Search decrypted v5 metadata by name, URI and username. Filters combine with AND: query (substring), target_url (site origin), username. target_url alone lists every account on that site. Then passbolt_select. Never returns passwords or notes."
  },
  "passbolt_select": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "target_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "query": {
          "default": "",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "type": "integer"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resource_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "description": "Bind exactly one record and return its decrypted note plus selection_id. Use resource_id for a known record, or filters (target_url/query/username). Several matches return ambiguous: true with candidates and bind nothing. Never returns the password or secret note."
  },
  "passbolt_create_resource": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "secret_source": {
          "additionalProperties": true,
          "type": "object"
        },
        "idempotency_key": {
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "folder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "share_with_groups": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "share_with_users": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "share_mode": {
          "default": "explicit",
          "type": "string"
        },
        "resource_type": {
          "default": "v5-default",
          "type": "string"
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "uri",
        "username",
        "secret_source",
        "idempotency_key"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "description": "Create a v5 resource with a server_generated or sealed_ref secret (no plaintext input). Use for onboarding. Writes: idempotent, within policy."
  },
  "passbolt_update_resource": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "type": "string"
        },
        "fields": {
          "additionalProperties": true,
          "type": "object"
        },
        "expected_modified": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "resource_id",
        "fields",
        "expected_modified",
        "idempotency_key"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "description": "Update a resource (approval-gated, optimistic concurrency). First call returns approval_id; repeat after operator acceptance. Writes: overwrites."
  },
